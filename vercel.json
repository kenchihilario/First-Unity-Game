{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/WebGLBuild/index.html" },
    { "source": "/Build/(.*)", "destination": "/WebGLBuild/Build/$1" },
    { "source": "/TemplateData/(.*)", "destination": "/WebGLBuild/TemplateData/$1" },
    { "source": "/((?!WebGLBuild/).*)", "destination": "/WebGLBuild/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/(.*)Build/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
